# Пример конфигурации rustream

# Папки с музыкой (сканируются рекурсивно)
music_dirs = ["/music"]

# Адрес сервера
bind_addr = "0.0.0.0:4533"

# База SQLite (создаётся автоматически)
db_path = "/var/lib/rustream/rustream.db"

# Каталог с собранным веб-интерфейсом (относительно рабочей директории)
static_dir = "static"

# Искать тексты песен в интернете, если рядом с треком нет .lrc/.txt
online_lyrics = true

# Как часто пересканировать библиотеку (секунды). Новые файлы из торрентов
# появятся автоматически; кнопка «Обновить» запускает скан вручную.
scan_interval_secs = 300

# Регистрация только по коду приглашения: код выдаёт администратор в профиле.

# YouTube Music, привязанный к профилям: каждый пользователь подключает свои
# cookies на странице «Профиль». Cookies хранятся в базе в зашифрованном виде.
ytm_enabled = true
# Путь к yt-dlp (в Docker-образе он уже установлен)
ytdlp_path = "yt-dlp"
# Кэш audio, разложенный по пользователям; старые файлы вытесняются
ytm_cache_dir = "cache/ytm"
# Предельный размер кэша в мегабайтах, 0 — не кэшировать
ytm_cache_max_mb = 1024
# Прокси для YouTube Music, если сеть сервера его не пускает
# (используется и для запросов, и для yt-dlp):
# ytm_proxy = "socks5h://192.168.10.5:1080"   # или "http://host:3128"

# Last.fm: приложение на https://www.last.fm/api/account/create
# Ключи можно вписать здесь или сохранить из веб-интерфейса
# (Аккаунт → Скробблинг, только для администратора) — сервер сам обновит файл.
# Без ключей можно вставить session key вручную в настройках пользователя.
# lastfm_api_key = "..."
# lastfm_api_secret = "..."
