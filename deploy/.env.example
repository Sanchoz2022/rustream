# Скопируйте в deploy/.env и поправьте под себя. Файл не попадает в git.

# Хост, на котором выполняется `pct` (обычно Proxmox)
DEPLOY_SSH=pve

# Id LXC-контейнера с rustream
LXC_ID=104

# Каталог установки внутри контейнера
RUSTREAM_DIR=/opt/rustream

# Публичный адрес для проверок после выкладки (можно оставить пустым)
HOST_URL=http://192.168.10.104:4533
